{
  "realm": "mbiling",
  "displayName": "Mbiling",
  "displayNameHtml": "Mbiling",
  "enabled": true,
  "sslRequired": "external",

  "registrationAllowed": false,
  "registrationEmailAsUsername": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "editUsernameAllowed": false,
  "resetPasswordAllowed": true,
  "rememberMe": true,
  "verifyEmail": false,

  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 10,
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "maxDeltaTimeSeconds": 43200,
  "passwordPolicy": "length(10) and notUsername and notEmail",

  "internationalizationEnabled": true,
  "supportedLocales": ["fr", "en"],
  "defaultLocale": "fr",

  "accessTokenLifespan": 900,
  "ssoSessionIdleTimeout": 2592000,
  "ssoSessionMaxLifespan": 7776000,
  "actionTokenGeneratedByUserLifespan": 1800,

  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA1",
  "otpPolicyDigits": 6,
  "otpPolicyPeriod": 30,
  "otpPolicyLookAheadWindow": 1,

  "clients": [
    {
      "clientId": "cellule",
      "name": "Cellule Mbiling",
      "description": "Le moteur de la cellule de test (fournisseur « self_hosted » du moteur). Adresse de retour et secret posés par installer.sh.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": true,
      "redirectUris": [],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+"
      }
    }
  ]
}
