# Passerelle Mbiling (phase 0).
# Le TLS est assuré par le tunnel Cloudflare : ici, HTTP simple sur le réseau local.
{
	admin off
	auto_https off
	servers {
		# Le tunnel arrive par le pont Docker : lui faire confiance pour l'adresse du client.
		trusted_proxies static private_ranges
	}
}

:8090 {
	log

	handle /sante {
		respond "ok" 200
	}

	# Les routes d'administration du Relais ne sortent jamais du serveur.
	handle /interne/* {
		respond 404
	}

	# Les lots 3 (cellule) et 4 (Relais, /mains) ajoutent leurs routes ici.
	handle {
		header Content-Type "text/plain; charset=utf-8"
		respond "Mbiling ({$MBILING_DOMAINE}) : serveur en préparation." 503
	}
}
