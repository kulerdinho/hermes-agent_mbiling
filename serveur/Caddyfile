# Passerelle Mbiling (phase 0).
# Le TLS est assuré par le tunnel Cloudflare : ici, HTTP simple sur le réseau local.
{
	admin off
	auto_https off
	servers {
		# Le tunnel arrive par le pont Docker : lui faire confiance pour l'adresse du client.
		trusted_proxies static private_ranges
	}
}

:8090 {
	log

	handle /sante {
		respond "ok" 200
	}

	# Les routes d'administration du Relais ne sortent jamais du serveur.
	handle /interne/* {
		respond 404
	}

	# Serveur de comptes (phase 1) : seules les pages des utilisateurs du royaume « mbiling »
	# sortent. L'administration et le royaume d'administration (master) restent internes : on
	# les ouvre par un tunnel SSH vers 127.0.0.1:MBILING_COMPTES_PORT_ADMIN.
	handle /comptes/* {
		@comptes_interne path /comptes/admin /comptes/admin/* /comptes/realms/master /comptes/realms/master/*
		# « respond » passe avant « reverse_proxy » dans l'ordre des directives de Caddy.
		respond @comptes_interne 404
		reverse_proxy comptes:8080
	}

	# Management : l'espace d'administration (accès réservé, vérifié par le service lui-même).
	@management path /management /management/*
	handle @management {
		reverse_proxy management:8100
	}

	# Les Mains (PC de l'utilisateur) se connectent au Relais en WebSocket.
	handle /mains {
		reverse_proxy relais:8000
	}

	# Tout le reste va à la cellule (API et WebSocket du Desktop, protégés par son jeton).
	handle {
		reverse_proxy cellule:9119
	}
}
