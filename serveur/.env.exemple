# Configuration du serveur Mbiling (phase 0).
# Copier ce fichier en `.env` (jamais commité), puis l'adapter.
# Il est lu par docker compose, par installer.sh et par la sauvegarde nocturne.

# Adresse publique du serveur. Provisoire : sous-domaine de chloe-consulting,
# en attendant api.mbiling.com.
MBILING_DOMAINE=mbiling.chloe-consulting.bid

# Port local (127.0.0.1) où écoute la passerelle. Le tunnel Cloudflare y envoie le trafic.
MBILING_PORT_LOCAL=8090

# Fichier du jeton du tunnel Cloudflare, déposé sur le serveur par l'administrateur.
# S'il est absent, la passerelle tourne seule, en local.
MBILING_JETON_TUNNEL_FICHIER=/etc/mbiling/cloudflared.token

# Versions des images (épinglées). L'image du moteur est construite sur le serveur
# depuis ce dépôt : sudo docker build -t mbiling-moteur:phase0 .
MBILING_IMAGE_CADDY=caddy:2.10-alpine
MBILING_IMAGE_CLOUDFLARED=cloudflare/cloudflared:2025.11.1
MBILING_IMAGE_MOTEUR=mbiling-moteur:phase0

# Connexion des utilisateurs de la phase 0 (Desktop et navigateur) : identifiant et mot de passe,
# en attendant le serveur de comptes (Google, Apple). installer.sh génère le mot de passe et la
# clé de signature des sessions s'ils sont vides ; la cellule ne reçoit que l'empreinte du mot de
# passe. Le mot de passe se lit ici, sur le serveur (sudo cat serveur/.env), jamais ailleurs.
MBILING_CONNEXION_IDENTIFIANT=testeur
MBILING_CONNEXION_MOT_DE_PASSE=
MBILING_CONNEXION_SECRET=
MBILING_CONNEXION_EMPREINTE=

# Mode de connexion des utilisateurs à la cellule de test :
#  - motdepasse : l'identifiant et le mot de passe partagés ci-dessus (phase 0) ;
#  - comptes    : chacun son compte, sur le serveur de comptes (phase 1). Demande MBILING_COMPTES=1.
MBILING_CONNEXION=motdepasse

# Mbiling Comptes, partie identité (phase 1, lot 1) : Keycloak sous https://MBILING_DOMAINE/comptes.
# 1 = démarré par installer.sh. Les mots de passe internes sont générés dans .env au premier lancement.
MBILING_COMPTES=0
MBILING_IMAGE_KEYCLOAK=quay.io/keycloak/keycloak:26.4.0
MBILING_IMAGE_POSTGRES=postgres:17-alpine
MBILING_COMPTES_MEMOIRE=1g
# Administration du serveur de comptes, en local seulement : depuis votre PC,
#   ssh -p <port ssh> -L 8091:127.0.0.1:8091 <serveur>   puis   http://127.0.0.1:8091/comptes/admin
# (identifiant « admin », mot de passe MBILING_COMPTES_ADMIN_MOT_DE_PASSE ci-dessous).
MBILING_COMPTES_PORT_ADMIN=8091
# Inscription libre : fermée (0) tant qu'une seule cellule de test sert tous les comptes. Les
# comptes de test se créent avec ./comptes/creer-compte.sh.
MBILING_COMPTES_INSCRIPTION_OUVERTE=0
# Envoi des emails (vérification de l'adresse, mot de passe oublié) : se règle dans Management
# (https://MBILING_DOMAINE/management, écran « Emails »). Ces lignes ne servent qu'à la première
# installation : Management les importe une fois (mot de passe chiffré), puis on les vide.
MBILING_EMAIL_SERVEUR=
MBILING_EMAIL_PORT=587
MBILING_EMAIL_EXPEDITEUR=
MBILING_EMAIL_IDENTIFIANT=
MBILING_EMAIL_MOT_DE_PASSE=

# La cellule de test : son organisation, ses profils d'agents et ses limites
# (le serveur est partagé avec d'autres services).
MBILING_ORGANISATION=org-test
MBILING_PROFILS="assistant comptable"
MBILING_CELLULE_MEMOIRE=3g
MBILING_CELLULE_CPU=2
# Où s'exécutent les commandes des agents : « mbiling_mains » = sur le PC du client, toujours
# (aucun profil ne peut les ramener dans la cellule).
MBILING_TERMINAL_CELLULE=mbiling_mains

# Modèle d'IA de la cellule, au format fournisseur:modèle (ex. openrouter:...), ou le nom du
# modèle chez la passerelle MBILING_IA_URL (ex. gemini/gemini-3.6-flash).
MBILING_MODELE=
# Passerelle d'IA compatible OpenAI (ex. OmniRoute : http://10.10.45.8:20128/v1) ; vide = fournisseur direct.
MBILING_IA_URL=
# Avec une passerelle seulement : modèle de secours (limite 429, panne) et modèle de la vision
# (doit accepter les images). Vides = aucun.
MBILING_MODELE_SECOURS=
MBILING_MODELE_VISION=
# Clé d'IA de TEST, plafonnée chez le fournisseur : nom de la variable attendue par
# le fournisseur (ex. OPENROUTER_API_KEY) et sa valeur. Copiée dans les secrets de la cellule.
MBILING_CLE_IA_VARIABLE=
MBILING_CLE_IA=

# Données des cellules et du Relais, et dossier des sauvegardes.
MBILING_DONNEES=/home/django/projets/mbiling-donnees
MBILING_SAUVEGARDES=/home/django/projets/mbiling-sauvegardes

# Sauvegarde nocturne : heure (format OnCalendar de systemd) et durée de conservation en jours.
MBILING_SAUVEGARDE_HEURE=02:30
MBILING_SAUVEGARDE_JOURS=14

# Jetons internes : laissés vides ici, installer.sh les génère dans .env au premier lancement.
# MBILING_JETON_CELLULE            le Desktop le présente à la cellule
# MBILING_RELAIS_JETON_INTERNE     la cellule le présente au Relais
# MBILING_JETON_APPAREIL_PC_TEST_1 le PC de test le présente au Relais
# MBILING_COMPTES_ADMIN_MOT_DE_PASSE  administration du serveur de comptes
# MBILING_COMPTES_DB_MOT_DE_PASSE     sa base de données
# MBILING_COMPTES_SECRET_CELLULE      la cellule le présente au serveur de comptes
# MBILING_MANAGEMENT_CLIENT_SECRET    Management le présente au serveur de comptes (connexion)
# MBILING_MANAGEMENT_API_SECRET       compte de service de Management (réglages du royaume)
# MBILING_MANAGEMENT_CLE              clé maîtresse de Management (chiffre secrets et sessions)
