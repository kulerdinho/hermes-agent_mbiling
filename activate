#!/usr/bin/env bash
# ============================================================================
# venv-style activation of the Mbiling dev environment for an interactive shell.
#
#   source ./activate       (bash / zsh, repo root)
#   source ./activate.fish  (fish)
#   .\activate.ps1          (PowerShell)
#
# Applies the composed pm env (PATH + tool vars) to the CURRENT shell, with
# save/restore: `deactivate` undoes exactly what activation changed.
#
# `mbiling` becomes a shell function for this checkout. It runs only while the
# shell is inside this worktree and refuses outside it, so a sibling worktree
# keeps its own command. A prompt prefix names the worktree.
#
# Scripts and other processes do not source this: they run under
# `scripts/run-in-mbiling-env`. Both build on scripts/_activation.sh.
#
# Sync through setup before selecting the environment. PM owns freshness;
# activation does not maintain a second dependency stamp. It trusts the
# recorded tool digest instead of re-hashing every entry. `mbiling pm
# install` and `mbiling update` keep that check.
# ============================================================================
_MBILING_REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# Options: `--test-extras a,b` selects the test environment's runtime extras
# (default: [all]); `--` ends options.
# A bare `source ./activate` inherits the caller's positional parameters.
# Ignore unrelated words so scripts with their own arguments can source it.
_mbiling_test_env="--test-environment"
_mbiling_expect_extras=""
for _mbiling_arg in "$@"; do
    if [ -n "$_mbiling_expect_extras" ]; then
        _mbiling_test_env="--test-environment=$_mbiling_arg"
        _mbiling_expect_extras=""
        continue
    fi
    case "$_mbiling_arg" in
        --) break ;;
        --test-extras) _mbiling_expect_extras=1 ;;
        --test-extras=*) _mbiling_test_env="--test-environment=${_mbiling_arg#--test-extras=}" ;;
        *) : ;;
    esac
done
if [ -n "$_mbiling_expect_extras" ]; then
    printf '%s\n' 'activate: --test-extras needs a comma-separated list' >&2
    unset _mbiling_arg _mbiling_test_env _mbiling_expect_extras
    return 2 2>/dev/null || exit 2
fi
unset _mbiling_arg _mbiling_expect_extras

# shellcheck source=scripts/_activation.sh
. "$_MBILING_REPO/scripts/_activation.sh"

if ! mbiling_sync "$_MBILING_REPO" "$_mbiling_test_env"; then
    printf '%s\n' 'activate: setup failed; shell environment unchanged' >&2
    unset _mbiling_test_env
    return 1 2>/dev/null || exit 1
fi
unset _mbiling_test_env

# Guard against double-sourcing: venv activate precedent (re-activating is a
# no-op re-save; we keep it idempotent by deactivating first). Key on the
# function, not the sentinel: child shells inherit __MBILING_ACTIVATED from an
# activated parent but never the function, and there is nothing to undo there.
if [ "$(type -t deactivate 2>/dev/null)" = "function" ]; then
    deactivate
fi

_mbiling_script="$(mbiling_compose_env "$_MBILING_REPO" sh)" || {
    echo "activate: could not compose the environment (see above)" >&2
    unset _mbiling_script
    return 1 2>/dev/null || exit 1
}
_mbiling_keys="$(printf '%s\n' "$_mbiling_script" | sed -n 's/^export \([A-Za-z_][A-Za-z0-9_]*\)=.*/\1/p' | tr '\n' ' ')"

# --- snapshot what we are about to change (deactivate restores this) ---
# __MBILING_ACTIVATED is part of the composed env below (it carries the
# installed-state path this environment was built from), so it is snapshotted
# and exported with every other key — no separate assignment here.
__MBILING_SAVED_PATH="$PATH"
for _mbiling_k in $_mbiling_keys; do
    eval "__MBILING_SAVED_$_mbiling_k=\"\${$_mbiling_k+set}\""
    eval "__MBILING_PRIOR_$_mbiling_k=\${$_mbiling_k-__MBILING_UNSET__}"
done
mbiling_apply_env "$_mbiling_script"

# This checkout, not whichever `mbiling` PATH finds. A function beats PATH, an
# alias, and a hashed command, including the MSIX execution alias.
__MBILING_WORKTREE="$_MBILING_REPO"
# The branch names the worktree. A checkout cannot share a branch with another.
__MBILING_WORKTREE_NAME="$(git -C "$_MBILING_REPO" rev-parse --abbrev-ref HEAD 2>/dev/null || :)"
if [ -z "$__MBILING_WORKTREE_NAME" ] || [ "$__MBILING_WORKTREE_NAME" = HEAD ]; then
    __MBILING_WORKTREE_NAME="$(basename "$_MBILING_REPO")"
fi
__MBILING_SAVED_PS1="${PS1-__MBILING_UNSET__}"
__MBILING_SAVED_PROMPT_COMMAND="${PROMPT_COMMAND-__MBILING_UNSET__}"

_mbiling_worktree_here() {
    _mbiling_top="$(git rev-parse --show-toplevel 2>/dev/null)" || return 1
    [ "$(cd "$_mbiling_top" && pwd -P)" = "$(cd "$__MBILING_WORKTREE" && pwd -P)" ]
}

mbiling() {
    _mbiling_worktree_here || {
        printf '%s\n' "mbiling: $(pwd) is outside $__MBILING_WORKTREE; refusing (the installed command is hidden while this checkout is active)" >&2
        return 1
    }
    (
        cd "$__MBILING_WORKTREE" || exit 1
        if [ -n "${PYTHON-}" ]; then
            exec "$PYTHON" mbiling "$@"
        elif [ -x .venv/Scripts/python.exe ]; then
            exec .venv/Scripts/python.exe mbiling "$@"
        elif [ -x .venv/bin/python ]; then
            exec .venv/bin/python mbiling "$@"
        elif [ -x venv/Scripts/python.exe ]; then
            exec venv/Scripts/python.exe mbiling "$@"
        elif [ -x venv/bin/python ]; then
            exec venv/bin/python mbiling "$@"
        else
            exec python mbiling "$@"
        fi
    )
}

_mbiling_prompt() {
    if [ "$__MBILING_SAVED_PS1" = "__MBILING_UNSET__" ]; then
        _mbiling_base_ps1=""
    else
        _mbiling_base_ps1="$__MBILING_SAVED_PS1"
    fi
    if _mbiling_worktree_here; then
        PS1="($__MBILING_WORKTREE_NAME) $_mbiling_base_ps1"
    else
        PS1="$_mbiling_base_ps1"
    fi
}

if [ -n "${PROMPT_COMMAND-}" ]; then
    PROMPT_COMMAND="_mbiling_prompt; ${PROMPT_COMMAND}"
else
    PROMPT_COMMAND=_mbiling_prompt
fi
_mbiling_prompt

deactivate() {
    export PATH="$__MBILING_SAVED_PATH"
    for _mbiling_k in $__MBILING_KEY_LIST; do
        eval "_mbiling_was=\"\$__MBILING_SAVED_$_mbiling_k\""
        eval "_mbiling_old=\"\$__MBILING_PRIOR_$_mbiling_k\""
        if [ "$_mbiling_was" != "set" ]; then
            unset "$_mbiling_k"
        else
            export "$_mbiling_k=$_mbiling_old"
        fi
        unset "__MBILING_SAVED_$_mbiling_k" "__MBILING_PRIOR_$_mbiling_k"
    done
    if [ "$__MBILING_SAVED_PS1" = "__MBILING_UNSET__" ]; then
        unset PS1
    else
        PS1="$__MBILING_SAVED_PS1"
    fi
    if [ "$__MBILING_SAVED_PROMPT_COMMAND" = "__MBILING_UNSET__" ]; then
        unset PROMPT_COMMAND
    else
        PROMPT_COMMAND="$__MBILING_SAVED_PROMPT_COMMAND"
    fi
    unset __MBILING_SAVED_PATH __MBILING_KEY_LIST __MBILING_ACTIVATED \
          __MBILING_WORKTREE __MBILING_WORKTREE_NAME \
          __MBILING_SAVED_PS1 __MBILING_SAVED_PROMPT_COMMAND
    unset -f deactivate mbiling _mbiling_worktree_here _mbiling_prompt
    unset _mbiling_k _mbiling_was _mbiling_old _mbiling_top
}

# remember the key list for deactivate (kept out of the loop vars above)
__MBILING_KEY_LIST="$_mbiling_keys"

# The composition library is not part of the user's shell.
unset -f mbiling_sync mbiling_bootstrap_python mbiling_compose_env mbiling_apply_env \
         mbiling_activation_current mbiling_ensure_env
unset _MBILING_REPO _mbiling_script _mbiling_keys _mbiling_k _mbiling_top
